# Production: copy to .env on the server and fill every value. NEVER commit .env.
# Local prod-shape rehearsal (catches DEBUG-only gaps before deploy):
#   set -a; source .env.production.example; set +a   # then edit real values
#   DJANGO_DEBUG=0 python manage.py check --deploy
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_ALLOWED_HOSTS=pos.example.com
CSRF_TRUSTED_ORIGINS=https://pos.example.com
CORS_ALLOW_ALL=False
CORS_EXTRA_ORIGINS=https://pos.example.com
SECURE_SSL_REDIRECT=true
DEPLOYMENT_MODE=on_premise
# SKIP_LICENSE intentionally absent: on_premise enforces even with DEBUG=True,
# so shops can rehearse expiry locally before it happens in production.
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
